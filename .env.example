# Postgres (Neon pooled URL in production; local Postgres works for dev)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aileaderboard
# Shared secret for POST /api/revalidate (header: x-revalidate-secret)
REVALIDATE_SECRET=change-me
# Public site origin, no trailing slash (used for canonical/hreflang/sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Used by the ingest workflow to call /api/revalidate
SITE_URL=http://localhost:3000
# Optional ingest summary
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
